ANDROID_VERSION_FILE='android/app/build.gradle'
ANDROID_TEXT_BEFORE_VERSION_CODE='versionName "'
ANDROID_TEXT_AFTER_VERSION_CODE='"'
ANDROID_MODULE_ROOT_PATH=''
ANDROID_IS_INCREMENT_REQUIRED_ONLY_ON_CHANGES='true'
ANDROID_MINOR_CHANGING_LOCATIONS=''
ANDROID_MAJOR_CHANGING_LOCATIONS=''
ANDROID_MODULE_DESCRIPTION='versionName in the Android app'

function after_successful_version_update() {
  old_version=$1
  new_version=$2
  [ "$SPECIFIED_PROJECT_MODULE" = 'ANDROID' ] || return 0
  [ "$old_version" = "$new_version" ] && return 0
  gradle="$ROOT_REPO_DIR/android/app/build.gradle"
  code=$(sed -n 's/.*versionCode \([0-9]*\).*/\1/p' "$gradle")
  sed -i "s/versionCode .*/versionCode $((code + 1))/" "$gradle"
}
