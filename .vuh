PYTHON_VERSION_FILE='python/pyproject.toml'
PYTHON_TEXT_BEFORE_VERSION_CODE='version = "'
PYTHON_TEXT_AFTER_VERSION_CODE='"'
PYTHON_MODULE_ROOT_PATH=''
PYTHON_IS_INCREMENT_REQUIRED_ONLY_ON_CHANGES='true'
PYTHON_MINOR_CHANGING_LOCATIONS=''
PYTHON_MAJOR_CHANGING_LOCATIONS=''
