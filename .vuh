MAIN_BRANCH_NAME='main'
VERSION_FILE='zig/build.zig.zon'
TEXT_BEFORE_VERSION_CODE='.version = "'
TEXT_AFTER_VERSION_CODE='",'
MODULE_ROOT_PATH=''
IS_INCREMENT_REQUIRED_ONLY_ON_CHANGES='true'
MINOR_CHANGING_LOCATIONS=''
MAJOR_CHANGING_LOCATIONS=''
PROJECT_MODULES='ZIG,PYTHON,ANDROID'

ZIG_VERSION_FILE='zig/build.zig.zon'
ZIG_TEXT_BEFORE_VERSION_CODE='.version = "'
ZIG_TEXT_AFTER_VERSION_CODE='",'
ZIG_MODULE_ROOT_PATH=''
ZIG_IS_INCREMENT_REQUIRED_ONLY_ON_CHANGES='true'
ZIG_MINOR_CHANGING_LOCATIONS=''
ZIG_MAJOR_CHANGING_LOCATIONS=''
