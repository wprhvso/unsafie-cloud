#!/usr/bin/env bash
set -eo pipefail

if [ "$#" -lt 1 ]; then
    echo "Usage: $0 <service_name> <command...>" >&2
    exit 1
fi

METRIC_DIR="{{ backup_metric_path }}"
ENV_FILE="{{ backup_config_path }}/s3.env"
LOCK_DIR="{{ backup_lock_path }}"

mkdir -p "$METRIC_DIR" "$LOCK_DIR"

if [ -f "$ENV_FILE" ]; then
    set -a
    source "$ENV_FILE"
    set +a
fi

if [ "$1" = "metric" ]; then
    SERVICE="$2"
    STATUS="$3"
    DURATION="$4"
    SIZE="${5:-0}"
    NOW=$(date +%s)
    HOST=$(hostname)
    TEMP_FILE="${METRIC_DIR}/backup_${SERVICE}.prom.$$"
    cat << METRICS > "$TEMP_FILE"
infra_backup_duration_seconds{db="${SERVICE}",host="${HOST}"} ${DURATION}
infra_backup_size_bytes{db="${SERVICE}",host="${HOST}"} ${SIZE}
infra_backup_status{db="${SERVICE}",host="${HOST}"} ${STATUS}
METRICS
    if [ "$STATUS" -eq 1 ]; then
        echo "infra_backup_last_success_timestamp{db=\"${SERVICE}\",host=\"${HOST}\"} ${NOW}" >> "$TEMP_FILE"
    fi
    mv "$TEMP_FILE" "${METRIC_DIR}/backup_${SERVICE}.prom"
    exit 0
fi

SERVICE="$1"
shift
COMMAND=("$@")

LOCK_FILE="${LOCK_DIR}/${SERVICE}.lock"
exec 200>"$LOCK_FILE"
if ! flock -n 200; then
    echo "Backup for ${SERVICE} is already in progress" >&2
    exit 1
fi

HOST=$(hostname)
START_TIME=$(date +%s.%N)
NOW=$(date +%s)

EXIT_CODE=0
"${COMMAND[@]}" || EXIT_CODE=$?

END_TIME=$(date +%s.%N)
DURATION=$(echo "$END_TIME - $START_TIME" | bc -l 2>/dev/null || awk "BEGIN {print $END_TIME - $START_TIME}")

TEMP_FILE="${METRIC_DIR}/backup_${SERVICE}.prom.$$"

if [ "$EXIT_CODE" -eq 0 ]; then
    STATUS=1
    cat << METRICS > "$TEMP_FILE"
infra_backup_last_success_timestamp{db="${SERVICE}",host="${HOST}"} ${NOW}
infra_backup_duration_seconds{db="${SERVICE}",host="${HOST}"} ${DURATION}
infra_backup_status{db="${SERVICE}",host="${HOST}"} ${STATUS}
METRICS
else
    STATUS=0
    cat << METRICS > "$TEMP_FILE"
infra_backup_duration_seconds{db="${SERVICE}",host="${HOST}"} ${DURATION}
infra_backup_status{db="${SERVICE}",host="${HOST}"} ${STATUS}
METRICS
fi

mv "$TEMP_FILE" "${METRIC_DIR}/backup_${SERVICE}.prom"
exit "$EXIT_CODE"
