        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(-max by (env) (delta(s3_objects{env=~\"$env\"}[1h])), 0)",
          "legendFormat": "удалено {{env}}",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 1,
