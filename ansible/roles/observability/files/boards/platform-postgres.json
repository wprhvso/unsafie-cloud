      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (env) (rate(pg_stat_database_blks_hit{env=~\"$env\"}[5m])) / (sum by (env) (rate(pg_stat_database_blks_hit{env=~\"$env\"}[5m])) + sum by (env) (rate(pg_stat_database_blks_read{env=~\"$env\"}[5m]))) * 100",
          "legendFormat": "{{env}}",
          "refId": "D",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 98
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value",
        "justifyMode": "auto"
      }
    },
