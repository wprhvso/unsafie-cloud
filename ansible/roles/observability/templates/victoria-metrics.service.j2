[Unit]
Description=VictoriaMetrics TSDB
After=network.target awg-quick@awg0.service

[Service]
Type=simple
ExecStart=/usr/local/bin/victoria-metrics -storageDataPath=/var/lib/victoria-metrics -httpListenAddr=127.0.0.1:8428,{{ awg_ip }}:8428 -promscrape.config=/etc/victoria-metrics/scrape.yml
Restart=always
RestartSec=5s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
