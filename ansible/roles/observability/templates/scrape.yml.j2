global:
  scrape_interval: 15s

scrape_configs:
  - job_name: "victoriametrics"
    static_configs:
      - targets: ["127.0.0.1:8428"]

  - job_name: "nodes"
    static_configs:
{% for host in groups['mesh'] %}
      - targets: ["{{ hostvars[host]['mesh_ip'] }}:9100"]
        labels:
          node: "{{ host }}"
{% endfor %}

  - job_name: "databases"
    static_configs:
{% for host in groups['mesh'] %}
      - targets: ["{{ hostvars[host]['mesh_ip'] }}:9187"]
        labels:
          node: "{{ host }}"
          db: "postgres"
{% endfor %}

  - job_name: "backups"
    scrape_interval: 30s
    static_configs:
{% for host in groups['mesh'] %}
      - targets: ["{{ hostvars[host]['mesh_ip'] }}:9100"]
        labels:
          node: "{{ host }}"
          tier: "backups"
{% endfor %}
