[Unit]
Description=WAL-G PostgreSQL Full Basebackup
After=postgresql@17-main.service network-online.target

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/bin/sh -c "/usr/local/bin/infra-backup-runner postgres /usr/local/bin/wal-g backup-push /var/lib/postgresql/17/main && /usr/local/bin/wal-g delete retain FULL {{ walg_retain_count }} --confirm"
