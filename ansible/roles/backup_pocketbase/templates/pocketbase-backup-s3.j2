#!/usr/bin/env bash
set -eo pipefail
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
TMP_DIR="/tmp/pb_backup_${TIMESTAMP}"
mkdir -p "$TMP_DIR"

if [ -f "{{ pocketbase_data_dir }}/data.db" ]; then
    sqlite3 "{{ pocketbase_data_dir }}/data.db" "VACUUM INTO '$TMP_DIR/data.db';" 2>/dev/null || cp "{{ pocketbase_data_dir }}/data.db" "$TMP_DIR/data.db"
fi

if [ -d "{{ pocketbase_data_dir }}/storage" ]; then
    rsync -a "{{ pocketbase_data_dir }}/storage" "$TMP_DIR/" 2>/dev/null || true
fi

TMP_ARCHIVE="/tmp/pb_${TIMESTAMP}.tar.zst"
tar -cf - -C "$TMP_DIR" . | zstd -3 > "$TMP_ARCHIVE"

/usr/local/bin/infra-s3-client upload "$TMP_ARCHIVE" "pocketbase/{{ inventory_hostname }}/pb_${TIMESTAMP}.tar.zst"

rm -rf "$TMP_DIR" "$TMP_ARCHIVE"
