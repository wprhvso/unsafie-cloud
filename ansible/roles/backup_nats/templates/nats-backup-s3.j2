#!/usr/bin/env bash
set -eo pipefail
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
TMP_DIR="/tmp/nats_backup_${TIMESTAMP}"
mkdir -p "$TMP_DIR"

if command -v nats >/dev/null 2>&1; then
    for stream in $(nats stream list --json 2>/dev/null | jq -r '.[].name' 2>/dev/null || true); do
        nats stream backup "$stream" "$TMP_DIR/$stream" 2>/dev/null || true
    done
fi

if [ -d "{{ nats_jetstream_dir }}" ]; then
    cp -r "{{ nats_jetstream_dir }}" "$TMP_DIR/jetstream" 2>/dev/null || true
fi

TMP_ARCHIVE="/tmp/nats_${TIMESTAMP}.tar.zst"
tar -cf - -C "$TMP_DIR" . | zstd -3 > "$TMP_ARCHIVE"

/usr/local/bin/infra-s3-client upload "$TMP_ARCHIVE" "nats/{{ inventory_hostname }}/nats_${TIMESTAMP}.tar.zst"

rm -rf "$TMP_DIR" "$TMP_ARCHIVE"
